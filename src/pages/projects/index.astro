---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Projects | Byron David Lencrerot III" description="Software projects by Byron David Lencrerot III, including PresiCompare, Huddle Up, ScholarDesk, Kokishin, Little Ask, and AEGIS.">
  <section class="m-projects" aria-label="Projects overview">
    <div class="projects-heading">
      <div class="intro">
        <p class="kicker">02 / PROJECTS</p>
        <h1>Software Projects with Real Impact</h1>
      </div>
      <div class="project-filters" role="group" aria-label="Filter projects by platform">
        <button type="button" class="project-filter" data-project-filter="all" aria-pressed="true">All <span data-filter-count="all">(6)</span></button>
        <button type="button" class="project-filter" data-project-filter="web" aria-pressed="false">Web Apps <span data-filter-count="web">(3)</span></button>
        <button type="button" class="project-filter" data-project-filter="mobile" aria-pressed="false">Mobile <span data-filter-count="mobile">(2)</span></button>
        <button type="button" class="project-filter" data-project-filter="desktop" aria-pressed="false">Desktop <span data-filter-count="desktop">(1)</span></button>
      </div>
    </div>
    <div class="project-carousel" aria-label="Featured projects" data-initial-project="AEGIS">
      <div class="project-carousel-viewport">
        <div class="project-carousel-track" style="--slide-index:0" aria-live="off">
          <article class="m-card" data-category="web" aria-label="Project 1 of 6">
            <img class="project-card-image" src="/images/presicompare.jpg" alt="PresiCompare project preview" />
            <div class="project-card-content">
              <h2>PresiCompare</h2>
              <p>A web application for comparing presidential terms using public data, without scoring or declaring a winner.</p>
              <div class="tags"><span>Web Application</span><span>Data Integration</span><span>User Experience</span></div>
              <a class="btn" href="#presicompare-title">View Project <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="m-card" data-category="mobile" aria-label="Project 2 of 6" inert aria-hidden="true">
            <img class="project-card-image" src="/images/huddle-up.jpg" alt="Huddle Up project preview" />
            <div class="project-card-content">
              <h2>Huddle Up</h2>
              <p>A community coordination mobile application built with React Native, Expo, and an ASP.NET Core API.</p>
              <div class="tags"><span>Mobile Application</span><span>React Native</span><span>ASP.NET Core</span></div>
              <a class="btn" href="#huddle-up" tabindex="-1">View Project <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="m-card" data-category="desktop" aria-label="Project 3 of 6" inert aria-hidden="true">
            <img class="project-card-image" src="/images/scholardesk-visit.jpg" alt="ScholarDesk project preview" />
            <div class="project-card-content">
              <h2>ScholarDesk</h2>
              <p>A local-first academic productivity desktop application for organizing coursework and research.</p>
              <div class="tags"><span>Desktop Application</span><span>Python</span><span>SQLite</span></div>
              <a class="btn" href="#scholardesk" tabindex="-1">View Project <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="m-card" data-category="web" aria-label="Project 4 of 6" inert aria-hidden="true">
            <img class="project-card-image" src="/images/kokishin.jpg" alt="Kokishin teaching and learning platform preview" />
            <div class="project-card-content">
              <h2>Kokishin</h2>
              <p>A teaching and learning management platform, currently establishing its backend foundation.</p>
              <div class="tags"><span>Learning Platform</span><span>.NET 10</span><span>Clean Architecture</span></div>
              <a class="btn" href="#kokishin" tabindex="-1">View Project <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="m-card" data-category="mobile" aria-label="Project 5 of 6" inert aria-hidden="true">
            <img class="project-card-image" src="/images/little-ask.jpg" alt="Little Ask parent and child mobile app preview" />
            <div class="project-card-content">
              <h2>Little Ask</h2>
              <p>A mobile app in development to help children and parents ask each other for quality time.</p>
              <div class="tags"><span>Mobile Application</span><span>Flutter</span><span>NestJS</span></div>
              <a class="btn" href="#little-ask" tabindex="-1">View Project <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="m-card" data-category="web" aria-label="Project 6 of 6" inert aria-hidden="true">
            <img class="project-card-image" src="/images/aeigis.jpg" alt="AEGIS ticket automation system preview" />
            <div class="project-card-content">
              <h2>AEGIS</h2>
              <p>An application monitoring and incident management system designed to detect issues and automate ticket creation.</p>
              <div class="tags"><span>Monitoring</span><span>Incident Management</span><span>Ticket Automation</span></div>
              <a class="btn" href="#aegis" tabindex="-1">View Project <span aria-hidden="true">→</span></a>
            </div>
          </article>
        </div>
      </div>
      <div class="project-carousel-controls" aria-label="Project carousel controls">
        <button class="carousel-arrow" type="button" data-carousel-previous aria-label="Previous project">←</button>
        <div class="carousel-pagination" aria-label="Choose a project" data-carousel-pagination></div>
        <button class="carousel-arrow" type="button" data-carousel-next aria-label="Next project">→</button>
        <button class="carousel-pause" type="button" data-carousel-pause aria-label="Pause automatic slide rotation">Pause</button>
      </div>
      <p class="visually-hidden" data-carousel-status aria-live="polite">Showing AEGIS, project 6 of 6.</p>
      <nav class="project-name-selector" aria-label="Select a featured project" data-project-selector></nav>
    </div>
  </section>
  <div class="projects-page">
    <section class="case-study presi" aria-labelledby="presicompare-title">
      <div class="case-index">
        <span class="index-number">01</span>
        <span class="case-status"><i class="status-dot"></i> LIVE WEBSITE</span>
      </div>
      <div class="case-content">
        <div class="case-heading">
          <div>
            <p class="eyebrow">DATA • HISTORY • PUBLIC INFORMATION</p>
            <h2 id="presicompare-title">PresiCompare</h2>
          </div>
          <a class="text-link" href="https://presicompare.com/" target="_blank" rel="noopener noreferrer">Visit live site <span aria-hidden="true">↗</span></a>
        </div>
        <p class="case-lede">A data-driven historical analysis platform that organizes public statistics around U.S. presidential terms, helping people examine trends and compare equivalent periods without assigning political scores or declaring a winner.</p>
        <div class="feature-grid">
          <article class="feature">
            <span class="feature-number">01 / COLLECT</span>
            <h3>Public data pipeline</h3>
            <p>Imports economic and labor statistics from configured data providers, normalizes observations, and stores their dates, values, metrics, and source context.</p>
          </article>
          <article class="feature">
            <span class="feature-number">02 / ORGANIZE</span>
            <h3>Presidential-term alignment</h3>
            <p>Models each presidential term separately and organizes observations by relative presidential year while retaining the actual calendar period.</p>
          </article>
          <article class="feature">
            <span class="feature-number">03 / EXPLORE</span>
            <h3>Comparison and discovery</h3>
            <p>Provides a web interface for comparing selected terms and exploring historical metrics through structured results, tables, and visualizations.</p>
          </article>
        </div>
        <div class="architecture">
          <div class="architecture-label">SYSTEM ARCHITECTURE</div>
          <div class="architecture-flow">
            <span>Government data sources</span><b>→</b>
            <span>.NET importer</span><b>→</b>
            <span>SQL Server</span><b>→</b>
            <span>ASP.NET Core API</span><b>→</b>
            <span>Blazor web app</span>
          </div>
        </div>
        <div class="project-footer">
          <div class="stack-block">
            <span class="eyebrow">TECHNOLOGY</span>
            <div class="tag-row">
              <span class="tag">C#</span><span class="tag">.NET 9</span><span class="tag">ASP.NET Core</span><span class="tag">Blazor</span><span class="tag">Entity Framework Core</span><span class="tag">SQL Server 2022</span><span class="tag">Docker</span><span class="tag">GitHub Actions</span><span class="tag">Ubuntu</span><span class="tag">Cloudflare Tunnel</span>
            </div>
          </div>
          <div class="repo-note"><span class="eyebrow">PROJECT ACCESS</span><p>The public website is live. The source repository is private.</p></div>
        </div>
        <aside class="scope-note"><strong>Data integrity matters.</strong> PresiCompare presents source-attributed observations for users to interpret. It does not claim that a president personally caused every change, and configured metrics are not necessarily all fully populated.</aside>
      </div>
    </section>

    <section id="huddle-up" class="case-study huddle" aria-labelledby="huddle-title">
      <div class="case-index">
        <span class="index-number">02</span>
        <span class="case-status"><i class="status-dot in-progress"></i> IN DEVELOPMENT</span>
      </div>
      <div class="case-content">
        <div class="case-heading">
          <div>
            <p class="eyebrow">COMMUNITIES • EVENTS • COORDINATION</p>
            <h2 id="huddle-title">Huddle Up</h2>
          </div>
          <span class="platform-label">Mobile-first product</span>
        </div>
        <p class="case-lede">A community platform designed to help people organize activities, coordinate decisions, share important information, and stay connected in one place. Huddle Up is built for many kinds of communities, not only families.</p>
        <div class="community-types" aria-label="Examples of communities">
          <span>Family</span><span>Friends</span><span>Sports</span><span>Neighborhoods</span><span>Education</span><span>Professional groups</span><span>Clubs &amp; interests</span><span>And more</span>
        </div>
        <div class="feature-grid huddle-features">
          <article class="feature">
            <span class="feature-number">01 / CONNECT</span>
            <h3>Communities and membership</h3>
            <p>Community creation, membership, Admin and Member roles, invitation codes, discoverability settings, and approval-based join requests form the community model.</p>
          </article>
          <article class="feature">
            <span class="feature-number">02 / ORGANIZE</span>
            <h3>Events and Kickbacks</h3>
            <p>Events support planned activities. Kickbacks are intended for spontaneous gatherings, with a faster, more casual flow than a scheduled event.</p>
          </article>
          <article class="feature">
            <span class="feature-number">03 / PARTICIPATE</span>
            <h3>Polls and Announcements</h3>
            <p>Polls give communities a way to gather input, while Announcements provide a place for community information and updates.</p>
          </article>
        </div>
        <div class="architecture">
          <div class="architecture-label">APPLICATION ARCHITECTURE</div>
          <div class="architecture-flow huddle-flow">
            <span>Expo / React Native mobile app</span><b>↔</b>
            <span>ASP.NET Core API</span><b>↔</b>
            <span>Relational database / EF Core</span>
          </div>
        </div>
        <div class="project-footer">
          <div class="stack-block">
            <span class="eyebrow">TECHNOLOGY</span>
            <div class="tag-row">
              <span class="tag">React Native</span><span class="tag">Expo</span><span class="tag">TypeScript</span><span class="tag">Expo Router</span><span class="tag">ASP.NET Core</span><span class="tag">C#</span><span class="tag">Entity Framework Core</span><span class="tag">REST API</span>
            </div>
          </div>
          <div class="repo-note"><span class="eyebrow">PROJECT ACCESS</span><p>The code repository is private. Release readiness and all end-to-end workflows remain subject to validation.</p></div>
        </div>
        <aside class="scope-note"><strong>Current engineering priority.</strong> Protecting a reliable baseline, validating existing workflows, and resolving known issues before expanding the feature set. Planned or incomplete functionality is not presented as release-ready.</aside>
      </div>
    </section>

    <section id="scholardesk" class="case-study scholardesk" aria-labelledby="scholardesk-title">
      <div class="case-index">
        <span class="index-number">03</span>
        <span class="case-status"><i class="status-dot"></i> LIVE PRODUCT</span>
      </div>
      <div class="case-content">
        <div class="case-heading">
          <div>
            <p class="eyebrow">ACADEMIC ORGANIZATION • RESEARCH • LOCAL-FIRST</p>
            <h2 id="scholardesk-title">ScholarDesk</h2>
          </div>
          <a class="text-link" href="https://scholardeskapp.com" target="_blank" rel="noopener noreferrer">Visit product website <span aria-hidden="true">↗</span></a>
        </div>
        <p class="case-lede">ScholarDesk is a local-first academic productivity desktop application that helps students organize coursework, manage research materials, and structure literature review workflows. The Windows application stores user data locally in SQLite; its separate product website provides product information and download access.</p>
        <div class="feature-grid">
          <article class="feature">
            <span class="feature-number">01 / ORGANIZE</span>
            <h3>Course folders</h3>
            <p>Creates a consistent structure for course materials and academic work, reducing repetitive manual folder setup.</p>
          </article>
          <article class="feature">
            <span class="feature-number">02 / RESEARCH</span>
            <h3>Sources and literature</h3>
            <p>Provides a research source library and literature map to help students organize materials and relationships between sources.</p>
          </article>
          <article class="feature">
            <span class="feature-number">03 / CAPTURE</span>
            <h3>Academic notes</h3>
            <p>Keeps notes within the same desktop workspace as coursework and research organization.</p>
          </article>
        </div>
        <div class="architecture">
          <div class="architecture-label">PRODUCT ARCHITECTURE</div>
          <div class="architecture-flow">
            <span>Python / Tkinter desktop app</span><b>→</b>
            <span>SQLite local data</span><b>·</b>
            <span>Separate React / Vite product website</span>
          </div>
        </div>
        <div class="project-footer">
          <div class="stack-block">
            <span class="eyebrow">TECHNOLOGY &amp; DISTRIBUTION</span>
            <div class="tag-row">
              <span class="tag">Python</span><span class="tag">Tkinter</span><span class="tag">SQLite</span><span class="tag">PyInstaller</span><span class="tag">Velopack</span><span class="tag">React</span><span class="tag">Vite</span><span class="tag">Tailwind CSS</span><span class="tag">GitHub Actions</span>
            </div>
          </div>
          <div class="repo-note"><span class="eyebrow">PRODUCT ACCESS</span><p>The public website and Windows application are separate deliverables, with independent deployment and release infrastructure.</p></div>
        </div>
      </div>
    </section>

    <section id="kokishin" class="case-study kokishin" aria-labelledby="kokishin-title">
      <div class="case-index">
        <span class="index-number">04</span>
        <span class="case-status"><i class="status-dot in-progress"></i> IN DEVELOPMENT</span>
      </div>
      <div class="case-content">
        <div class="case-heading">
          <div>
            <p class="eyebrow">TEACHING • LEARNING • COURSE MANAGEMENT</p>
            <h2 id="kokishin-title">Kokishin</h2>
          </div>
          <span class="platform-label">Backend foundation in progress</span>
        </div>
        <p class="case-lede">Kokishin is a Canvas-inspired teaching and learning management platform for organizing courses, instructional materials, learning activities, assessments, and feedback. Development is currently focused on the backend foundation; the React and TypeScript frontend is planned, not yet presented as implemented.</p>
        <div class="feature-grid">
          <article class="feature">
            <span class="feature-number">01 / ORGANIZE</span>
            <h3>Course structure</h3>
            <p>The platform is being designed to support organized course materials and instructional delivery for educators and learners.</p>
          </article>
          <article class="feature">
            <span class="feature-number">02 / ASSESS</span>
            <h3>Learning activities</h3>
            <p>Assessments and feedback are part of the planned teaching and learning workflow as the product develops.</p>
          </article>
          <article class="feature">
            <span class="feature-number">03 / ARCHITECT</span>
            <h3>Clean Architecture</h3>
            <p>Separate API, Application, Domain, and Infrastructure layers keep business rules independent from delivery and persistence details.</p>
          </article>
        </div>
        <div class="architecture">
          <div class="architecture-label">CURRENT TECHNICAL FOUNDATION</div>
          <div class="architecture-flow">
            <span>ASP.NET Core Web API</span><b>→</b>
            <span>Application / Domain</span><b>→</b>
            <span>EF Core / SQLite</span>
          </div>
        </div>
        <div class="project-footer">
          <div class="stack-block">
            <span class="eyebrow">CURRENT &amp; PLANNED TECHNOLOGY</span>
            <div class="tag-row">
              <span class="tag">.NET 10</span><span class="tag">ASP.NET Core</span><span class="tag">Clean Architecture</span><span class="tag">Entity Framework Core</span><span class="tag">SQLite</span><span class="tag">Health Checks</span><span class="tag">React planned</span><span class="tag">TypeScript planned</span>
            </div>
          </div>
          <div class="repo-note"><span class="eyebrow">PROJECT STATUS</span><p>Backend foundation is the current focus. Core learning-platform features and the frontend remain in development.</p></div>
        </div>
      </div>
    </section>

    <section id="little-ask" class="case-study little-ask" aria-labelledby="little-ask-title">
      <div class="case-index">
        <span class="index-number">05</span>
        <span class="case-status"><i class="status-dot in-progress"></i> IN DEVELOPMENT</span>
      </div>
      <div class="case-content">
        <div class="case-heading">
          <div>
            <p class="eyebrow">FAMILY • CONNECTION • QUALITY TIME</p>
            <h2 id="little-ask-title">Little Ask</h2>
          </div>
          <span class="platform-label">Mobile MVP in development</span>
        </div>
        <p class="case-lede">Little Ask is a parent-child bonding application centered on making it easier for children to ask their parents for shared activities and quality time. Requests are two-way, while the MVP stays focused on the core parent-child request and response experience.</p>
        <div class="feature-grid">
          <article class="feature">
            <span class="feature-number">01 / ASK</span>
            <h3>Invite connection</h3>
            <p>Children can make approachable requests for activities such as playing a game, watching a movie, or spending time together.</p>
          </article>
          <article class="feature">
            <span class="feature-number">02 / RESPOND</span>
            <h3>Two-way requests</h3>
            <p>Parents can also initiate requests, supporting a two-way interaction while keeping the product focused on family connection.</p>
          </article>
          <article class="feature">
            <span class="feature-number">03 / FOCUS</span>
            <h3>Purposeful MVP</h3>
            <p>The initial scope prioritizes requests and responses instead of adding social feeds, chat, gamification, or calendars.</p>
          </article>
        </div>
        <div class="architecture">
          <div class="architecture-label">APPLICATION ARCHITECTURE</div>
          <div class="architecture-flow">
            <span>Flutter / Dart</span><b>↔</b>
            <span>NestJS / TypeScript</span><b>↔</b>
            <span>PostgreSQL / Docker</span>
          </div>
        </div>
        <div class="project-footer">
          <div class="stack-block">
            <span class="eyebrow">TECHNOLOGY</span>
            <div class="tag-row">
              <span class="tag">Flutter</span><span class="tag">Dart</span><span class="tag">NestJS</span><span class="tag">TypeScript</span><span class="tag">PostgreSQL</span><span class="tag">Docker</span><span class="tag">Feature-first structure</span><span class="tag">Clean Architecture</span>
            </div>
          </div>
          <div class="repo-note"><span class="eyebrow">PROJECT STATUS</span><p>In development, with an MVP focused on parent-child activity requests and responses.</p></div>
        </div>
      </div>
    </section>

    <section id="aegis" class="case-study aegis" aria-labelledby="aegis-title">
      <div class="case-index">
        <span class="index-number">06</span>
        <span class="case-status"><i class="status-dot in-progress"></i> MVP SCOPE</span>
      </div>
      <div class="case-content">
        <div class="case-heading">
          <div>
            <p class="eyebrow">MONITORING • INCIDENTS • AUTOMATION</p>
            <h2 id="aegis-title">AEGIS</h2>
          </div>
          <span class="platform-label">Ticket Automation System</span>
        </div>
        <p class="case-lede">AEGIS is designed to centralize application monitoring and incident management. It detects application errors, failures, and service outages, then creates categorized tickets so development and operations teams can track incidents and respond with greater visibility.</p>
        <div class="feature-grid">
          <article class="feature">
            <span class="feature-number">01 / MONITOR</span>
            <h3>Detect application issues</h3>
            <p>Monitor applications and services for errors, failures, and outages that need attention.</p>
          </article>
          <article class="feature">
            <span class="feature-number">02 / AUTOMATE</span>
            <h3>Create and classify tickets</h3>
            <p>Automatically create an incident ticket and classify its severity when an issue is detected.</p>
          </article>
          <article class="feature">
            <span class="feature-number">03 / MANAGE</span>
            <h3>Track incident status</h3>
            <p>Provide a centralized place to manage tickets, follow incident status, and improve response visibility.</p>
          </article>
        </div>
        <div class="architecture">
          <div class="architecture-label">MVP SCOPE</div>
          <div class="architecture-flow">
            <span>Application &amp; service monitoring</span><b>→</b>
            <span>Incident detection</span><b>→</b>
            <span>Automated severity-based tickets</span><b>→</b>
            <span>Centralized tracking</span>
          </div>
        </div>
        <div class="scope-note"><strong>Future V2 direction:</strong> AI-powered incident analysis, GitHub issue and branch creation, coding-agent integration, proposed code fixes, and pull request workflows are longer-term goals—not part of the MVP.</div>
      </div>
    </section>

    <section class="closing-panel">
      <p class="eyebrow">HOW I APPROACH BUILDING</p>
      <h2>Make the system work.<br /><span>Make the details trustworthy.</span></h2>
      <p>Across these projects, I focus on the connection between user experience and the systems behind it: clear responsibilities between application layers, maintainable architecture, and validating real behavior rather than assuming that a screen or build proves a feature is complete.</p>
    </section>
  </div>
</BaseLayout>

<script>
  const carousel = document.querySelector('.project-carousel');

  if (carousel) {
    const track = carousel.querySelector('.project-carousel-track');
    const viewport = carousel.querySelector('.project-carousel-viewport');
    const slides = Array.from(track.querySelectorAll('.m-card'));
    const pagination = carousel.querySelector('[data-carousel-pagination]');
    const selector = carousel.querySelector('[data-project-selector]');
    const filters = Array.from(document.querySelectorAll('[data-project-filter]'));
    const status = carousel.querySelector('[data-carousel-status]');
    const pauseButton = carousel.querySelector('[data-carousel-pause]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const names = slides.map((slide) => slide.querySelector('h2').textContent.trim());
    const projectOrder = ['AEGIS', 'Huddle Up', 'Little Ask', 'Kokishin', 'PresiCompare', 'ScholarDesk'];
    slides.sort((first, second) => projectOrder.indexOf(first.querySelector('h2').textContent.trim()) - projectOrder.indexOf(second.querySelector('h2').textContent.trim()));
    slides.forEach((slide) => track.append(slide));
    names.splice(0, names.length, ...slides.map((slide) => slide.querySelector('h2').textContent.trim()));
    let activeSlide = Math.max(0, names.indexOf(carousel.dataset.initialProject));
    let activeFilter = 'all';
    let rotationTimer;
    let paused = reducedMotion.matches;
    let prependClone;
    let appendClone;
    let wrappingToClone = false;
    let translateX = 0;

    const visibleIndexes = () => slides
      .map((slide, index) => slide.dataset.category === activeFilter || activeFilter === 'all' ? index : -1)
      .filter((index) => index >= 0)
      .sort((first, second) => projectOrder.indexOf(names[first]) - projectOrder.indexOf(names[second]));

    const makeProjectButton = (index, className) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = className;
      button.dataset.projectIndex = String(index);
      button.setAttribute('aria-label', `Show ${names[index]}`);
      button.textContent = names[index];
      button.addEventListener('click', () => {
        showSlide(index);
        startRotation();
      });
      return button;
    };

    const renderSelectors = () => {
      const indexes = visibleIndexes();
      track.querySelectorAll('.peek-clone').forEach((clone) => clone.remove());
      prependClone = null;
      appendClone = null;
      slides.forEach((slide, index) => {
        slide.hidden = !indexes.includes(index);
      });
      const makePeekClone = (index) => {
        const clone = slides[index].cloneNode(true);
        clone.classList.add('peek-clone');
        clone.hidden = false;
        clone.inert = true;
        clone.setAttribute('aria-hidden', 'true');
