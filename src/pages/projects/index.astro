      });
    };

    const centerCard = (card) => {
      const viewportRect = viewport.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const viewportCenter = viewportRect.left + viewport.clientLeft + viewport.clientWidth / 2;
