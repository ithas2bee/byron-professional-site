---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Teaching | Byron David Lencrerot III" description="Teaching interests and planned educational content of Byron David Lencrerot III.">
  <section class="teaching-hero" aria-labelledby="teaching-title">
    <div class="teaching-hero-inner">
      <div class="hero-copy">
        <p class="kicker">OS / TEACHING</p>
        <h1 id="teaching-title">Helping Others<br />Learn and Grow</h1>
        <p class="lede">My goal is to develop lectures, videos, and learning resources that make technology understandable and practical for both children and adults.</p>
        <div class="hero-actions"><a class="btn" href="#planned-content">Explore Teaching Content <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
    <div class="hero-image"><img src="/images/engineering-workspace.png" alt="A laptop in a practical software engineering workspace." /></div>
  </section>
  <div class="inner-page">
    <section class="content-grid" aria-labelledby="teaching-approach">
      <p class="side-label">TEACHING APPROACH</p>
      <div class="prose">
        <h2 id="teaching-approach">A foundation in I, We, You</h2>
        <p>I follow teaching methods from Norman Eng’s book <em>Teaching College</em>. The I, We, You approach is a foundation for my teaching: I demonstrate a concept, we work through it together, and you apply it independently.</p>
        <div class="card-grid teaching-model">
          <article class="info-card"><span class="step-number">01 / I</span><h3>I demonstrate</h3><p>Introduce and demonstrate the concept.</p></article>
          <article class="info-card"><span class="step-number">02 / WE</span><h3>We work together</h3><p>Work through the concept together.</p></article>
          <article class="info-card"><span class="step-number">03 / YOU</span><h3>You apply it</h3><p>Apply the concept independently.</p></article>
        </div>
      </div>
    </section>

    <div class="page-rule"></div>

    <section class="content-grid" id="planned-content" aria-labelledby="content-plan-title">
      <p class="side-label">PLANNED CONTENT</p>
      <div>
        <div class="prose">
          <h2 id="content-plan-title">Related lectures and videos</h2>
          <p>I envision connected educational videos that span related lectures and link topics across a series. These plans focus on accessible explanations and showing how technical ideas can be used in practice.</p>
        </div>
        <div class="card-grid content-plans">
          <article class="info-card"><h3>Coding concepts for children and adults</h3><p>Explain coding concepts in ways that both children and adults can understand.</p></article>
          <article class="info-card"><h3>Interview problems in real applications</h3><p>Show how coding interview or LeetCode-style problems relate to real-world business problems and actual software applications.</p></article>
          <article class="info-card"><h3>Technical concepts in practical use</h3><p>Connect technical concepts to understandable examples, practical use, and real applications.</p></article>
        </div>
      </div>
    </section>

    <aside class="planned-note">
      <p class="kicker">A DEVELOPING TEACHING PORTFOLIO</p>
      <h2>Planned educational content</h2>
      <p>The concepts on this page are plans for future educational content; no lecture, video, or series is presented here as already published.</p>
    </aside>
  </div>
</BaseLayout>
<style>
  :global(body){background:#fff}
  .teaching-hero{position:relative;isolation:isolate;overflow:hidden;background:#f7f8f9;border-bottom:1px solid #d9dce0;color:#17191d}
  .teaching-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#f7f8f9 0%,rgba(247,248,249,.98) 34%,rgba(247,248,249,.84) 45%,rgba(247,248,249,.2) 63%,transparent 76%)}
  .teaching-hero-inner{position:relative;z-index:2;width:min(1380px,calc(100% - 88px));min-height:clamp(220px,35.5vw,500px);margin:0 auto;display:flex;align-items:center;padding:32px 0}
  .hero-copy{width:min(46%,490px);max-width:490px}
  .hero-copy .kicker{font-size:.65rem;letter-spacing:.12em;font-weight:700;color:#737982;margin:0 0 8px}
  .hero-copy h1{font-size:clamp(1.8rem,3.5vw,3.5rem);line-height:1.03;letter-spacing:-.045em;font-weight:650;margin:0 0 12px}
  .hero-copy .lede{max-width:460px;font-size:.88rem;line-height:1.5;color:#555b63;margin:0}
  .hero-actions{display:flex;gap:12px;margin-top:17px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:14px;padding:10px 14px;font-size:.76rem;font-weight:700;text-decoration:none;border:1px solid #bfc6cd;border-radius:5px;background:#fff;color:#17191d;transition:background-color .15s ease,border-color .15s ease}
  .btn:hover{background:#f1f3f5;border-color:#8a929a}
  .hero-image{position:absolute;z-index:0;inset:0 0 0 34%;min-width:0}
  .hero-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .inner-page{width:min(1120px,calc(100% - 72px));margin:0 auto;padding:58px 0 82px;color:#191b1f}
  .content-grid{display:grid;grid-template-columns:190px minmax(0,1fr);gap:46px}
  .side-label{font-size:.65rem;font-weight:700;letter-spacing:.13em;color:#7c8188;margin:5px 0 0}
  .prose h2{font-size:clamp(1.55rem,3vw,2rem);line-height:1.15;letter-spacing:-.04em;margin:0 0 15px}
  .prose p{font-size:.93rem;line-height:1.8;color:#5d626a;margin:0 0 17px}
  .page-rule{height:1px;background:#d9dce0;margin:38px 0}
  .card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:25px;border-top:1px solid #d9dce0;border-bottom:1px solid #d9dce0}
  .info-card{padding:20px 19px 22px 0;min-width:0}
  .info-card+.info-card{border-left:1px solid #d9dce0;padding-left:19px}
  .info-card h3{font-size:.96rem;line-height:1.4;letter-spacing:-.02em;margin:0 0 9px}
  .info-card p{font-size:.81rem;line-height:1.7;color:#646971;margin:0}
  .step-number{display:block;font-size:.6rem;letter-spacing:.12em;font-weight:700;color:#777c83;margin-bottom:18px}
  .planned-note{margin-top:38px;padding:26px 28px;background:#10161d;color:#fff;border-left:4px solid #aeb8c2}
  .planned-note .kicker{font-size:.61rem;letter-spacing:.13em;color:#aeb8c2;margin:0 0 11px}
  .planned-note h2{font-size:1.35rem;letter-spacing:-.03em;margin:0 0 9px}
  .planned-note>p:last-child{max-width:740px;color:#d1d8de;font-size:.87rem;line-height:1.75;margin:0}
  @media(max-width:900px){.teaching-hero-inner{padding:20px 0}.hero-copy{width:min(50%,420px);max-width:420px}.hero-copy .kicker{font-size:.6rem;margin-bottom:6px}.hero-copy h1{font-size:clamp(1.75rem,4vw,2.8rem);margin-bottom:9px}.hero-copy .lede{font-size:.8rem;line-height:1.45}.hero-actions{margin-top:14px}.btn{padding:8px 12px;font-size:.7rem}}
  @media(max-width:760px){.inner-page{width:calc(100% - 36px);padding:42px 0 68px}.content-grid{grid-template-columns:1fr;gap:14px}.card-grid{grid-template-columns:1fr}.info-card{padding:18px 0}.info-card+.info-card{border-left:0;border-top:1px solid #d9dce0;padding-left:0}.page-rule{margin:30px 0}.planned-note{margin-top:30px;padding:24px 21px}}
  @media(max-width:620px){.teaching-hero::before{background:linear-gradient(180deg,#f7f8f9 0%,rgba(247,248,249,.96) 39%,rgba(247,248,249,.72) 57%,transparent 76%)}.teaching-hero-inner{width:calc(100% - 36px);min-height:0;padding:36px 0 28px}.hero-copy{width:100%;max-width:620px}.hero-copy h1{font-size:clamp(2rem,8vw,3.1rem)}.hero-image{position:relative;inset:auto;width:100%;height:auto;aspect-ratio:16/9}.hero-image img{object-position:center}}
</style>
