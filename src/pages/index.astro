  .projects-section{background:#eceef0;border-top:1px solid #d5d9dd;border-bottom:1px solid #d5d9dd}
  .project-row{display:grid;grid-template-columns:38px minmax(250px,.85fr) minmax(300px,1fr);gap:25px;align-items:center;padding:28px 0;border-top:1px solid #c4cbd1}
  .project-number{font-size:.72rem;color:#69737d;padding-top:4px;align-self:start}
  .project-type{color:#707982;font-size:.56rem;margin:0 0 10px}
  .project-info h3{font-size:1.65rem;letter-spacing:-.045em;margin:0 0 10px;color:#111315}
  .project-description{color:#4e565e;font-size:.88rem;line-height:1.7;margin:0 0 12px;max-width:470px}
  .project-tech{color:#626b74;font-size:.57rem;margin:0 0 17px}
  .project-link{display:inline-flex;gap:20px;color:#17191c}
