---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    number: '01',
    name: 'PresiCompare',
    type: 'LIVE PRODUCT',
    description: 'An independent web application. Explore the product and its approach to presenting comparisons through a public-facing experience.',
    technologies: 'Web application / Product development',
    href: 'https://presicompare.com/',
    action: 'Open live product'
  },
  {
    number: '02',
    name: 'Huddle Up',
    type: 'MOBILE APPLICATION',
    description: 'A mobile application developed with React Native and Expo, backed by an ASP.NET Core API.',
    technologies: 'React Native / Expo / ASP.NET Core',
    href: '/projects/#huddle-up',
    action: 'Project details'
  }
];
---
<BaseLayout
  title="Byron David Lencrerot III | Software Engineer, Doctoral Student"
  description="Professional profile, software projects, and academic interests of Byron David Lencrerot III."
>
  <section class="hero">
    <div class="hero-photo" aria-hidden="true"></div>
    <div class="hero-inner page-width">
      <div class="hero-main">
        <p class="eyebrow"><span class="eyebrow-rule"></span> SOFTWARE ENGINEER <span>·</span> DOCTORAL STUDENT <span>·</span> FUTURE EDUCATOR</p>
        <h1>Byron David<br />Lencrerot <span>III</span></h1>
        <div class="hero-bottom">
          <p class="hero-role">Building technology. Solving real problems.<br /><span>Preparing to teach the next generation.</span></p>
          <div class="hero-intro">
            <p>Experienced in telecommunications and software engineering, independent developer, and doctoral student in Information Technology with a goal of teaching technology and helping others grow.</p>
            <div class="hero-links">
              <a class="button button-black" href="/projects/">View My Work <span aria-hidden="true">→</span></a>
              <a class="button button-outline" href="/contact/">Contact Me <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-identity" aria-hidden="true"><span>B</span><i>.</i>``</div>
    </div>
  </section>

  <section class="metrics-band">
    <div class="page-width metrics-grid">
      <div class="metric"><span class="metric-index">01</span><div><strong>Software Engineering</strong><small>Professional experience in telecommunications and software development.</small></div></div>
      <div class="metric"><span class="metric-index">02</span><div><strong>M.S. Information Systems Management</strong><small>University of Arizona Global Campus · 4.0 GPA</small></div></div>
      <div class="metric"><span class="metric-index">03</span><div><strong>Doctoral Student, Information Technology</strong><small>Capella University</small></div></div>
      <div class="metric"><span class="metric-index">04</span><div><strong>Independent Developer</strong><small>Web and mobile products with real-world applications.</small></div></div>
    </div>
  </section>

</BaseLayout>

<style>
  :global(:root){--black:#101214;--ink:#17191c;--mid:#646a71;--silver:#9ba1a8;--line:#d7dade;--mist:#f4f5f6;--white:#fff}
  .page-width{width:min(1380px,calc(100% - 80px));margin-inline:auto}
  .hero{position:relative;isolation:isolate;width:100vw;margin-left:calc(50% - 50vw);overflow:hidden}
  .hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.7fr);gap:clamp(28px,5vw,78px);padding-top:clamp(55px,6vw,86px);padding-bottom:clamp(48px,5vw,72px);align-items:center;min-height:510px}
  .hero-photo{position:absolute;inset:0;z-index:-2;background-image:linear-gradient(90deg,#f4f5f6 0%,rgba(244,245,246,.92) 8%,rgba(244,245,246,.35) 28%,rgba(244,245,246,.12) 52%,rgba(16,18,20,.2) 100%),url('/images/head-shot.png');background-size:cover;background-position:center top;background-repeat:no-repeat}
  .hero-main{position:relative;z-index:1;min-width:0}

