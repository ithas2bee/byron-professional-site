  .hero.page-width{width:min(1480px,calc(100% - 12px));min-height:clamp(370px,38vw,520px);grid-template-columns:minmax(0,1fr) minmax(0,.95fr);gap:0;padding:0 0 0 clamp(30px,5vw,70px);background:#f7f8f9;align-items:center}
