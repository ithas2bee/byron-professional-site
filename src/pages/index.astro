  @media(max-width:760px){.page-width{width:calc(100% - 32px)}.hero.page-width{width:calc(100% - 12px);display:block;min-height:0;padding:0 22px 210px}.hero-photo{width:100%;height:230px;top:auto;bottom:0;opacity:1;background-image:linear-gradient(180deg,#f7f8f9 0%,rgba(247,248,249,.03) 40%,rgba(16,22,29,.08) 100%),url('/images/head-shot.png');background-position:center 55%}.hero-main{padding:38px 0 18px}.hero .eyebrow{font-size:.49rem;margin-bottom:18px}.hero h1{font-size:clamp(3rem,14vw,4.2rem);margin-bottom:16px}.hero-bottom{grid-template-columns:1fr;gap:12px}.hero-role,.hero-intro>p{font-size:.83rem}}  .hero-identity{position:relative;z-index:1}
  .eyebrow,.section-rail,.aside-top,.aside-bottom,.metric small,.project-type,.project-tech,.card-index,.card-foot,.education-inner>div>span{font-size:.62rem;letter-spacing:.14em;font-weight:700}
  .eyebrow{color:#4d545b;display:flex;align-items:center;gap:10px;margin:0 0 30px}
  .eyebrow-rule{width:28px;height:2px;background:#17191c}
  .eyebrow-number{margin-left:auto;color:#777e86}
  h1{font-size:clamp(3.8rem,7.4vw,7.4rem);letter-spacing:-.078em;line-height:.88;font-weight:750;margin:0 0 27px;color:#101214;max-width:850px}
  h1 span{color:#90959b}
  .hero-bottom{display:grid;grid-template-columns:.72fr 1fr;gap:30px;border-top:1px solid #c9cdd1;padding-top:22px;max-width:850px}
  .hero-role{font-size:.92rem;line-height:1.6;font-weight:750;margin:0;color:#15171a}
  .hero-role span{color:#656b72;font-size:.78rem;font-weight:450}
