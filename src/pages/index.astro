  .academic-grid article{padding:24px 22px;min-height:210px;border-right:1px solid #cbd0d5;display:flex;flex-direction:column}.academic-grid article:last-child{border-right:0}
  .card-index{color:#6c7580;font-size:.56rem}.academic-grid h3{font-size:1.05rem;letter-spacing:-.02em;margin:23px 0 9px;color:#17191c}.academic-grid p{font-size:.82rem;line-height:1.7;color:#58616a;margin:0 0 22px}.card-foot{color:#7a838c;font-size:.52rem;margin-top:auto}
