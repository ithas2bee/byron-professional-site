  @media(max-width:1050px){.hero.page-width{grid-template-columns:minmax(0,1fr) minmax(0,.8fr);padding-left:32px}.hero-photo{width:46%}.hero-identity{left:54%;width:66px;height:66px}.hero-identity:before{width:54px;height:54px}.hero-identity:after{width:42px;height:60px}.hero h1{font-size:clamp(3rem,6vw,5rem)}}
  @media(max-width:760px){.page-width{width:calc(100% - 32px)}.hero.page-width{width:calc(100% - 12px);display:block;min-height:0;padding:0 22px 210px}.hero-photo{width:100%;height:230px;top:auto;bottom:0;opacity:1;background-image:linear-gradient(180deg,#f7f8f9 0%,rgba(247,248,249,.03) 40%,rgba(16,22,29,.08) 100%),url('/images/head-shot.png');background-position:center 55%}.hero-main{padding:38px 0 18px}.hero .eyebrow{font-size:.49rem;margin-bottom:18px}.hero h1{font-size:clamp(3rem,12vw,4.4rem);line-height:.9}.hero-role{font-size:1rem}.hero-role span{font-size:.93rem}.hero-intro>p{font-size:.82rem}.hero-identity{left:auto;right:19px;top:auto;bottom:163px;transform:none;width:52px;height:52px;font-size:2rem}.hero-identity:before{width:44px;height:44px}.hero-identity:after{width:34px;height:46px}.metrics-grid{width:calc(100% - 12px)}.metrics-grid{grid-template-columns:1fr 1fr}.metric{padding:14px 10px;min-height:76px;border-bottom:1px solid #35414b}.metric:first-child{padding-left:10px}.metric:nth-child(2){border-right:0}.metric strong{font-size:.67rem}.content-section.page-width{width:calc(100% - 32px)}}
