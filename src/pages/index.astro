  .art-presi{background:linear-gradient(135deg,#11161c,#28313b 60%,#e3e6e9)}
  .browser-art{width:78%;height:75%;background:#f9fafb;box-shadow:0 20px 40px #0004;border:5px solid #15191e;border-radius:5px;overflow:hidden}
