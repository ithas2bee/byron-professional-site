---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Résumé | Byron David Lencrerot III" description="Résumé and professional qualifications of Byron David Lencrerot III.">
  <section class="m-hero light" style="background-image:url('/images/resume-paper.svg')">
    <div class="m-hero-fade"></div>
    <div class="m-in">
      <p class="kicker">03 / RÉSUMÉ</p>
      <h1>Professional<br />Experience</h1>
      <p class="lede">Five distinct Comcast positions from July 2014 to June 2023, progressing from residential service work to advanced business installations before moving into software development.</p>
      <div class="m-actions"><a class="btn dark" href="#experience">View My Résumé <span aria-hidden="true">→</span></a><a class="btn" href="/contact/">Contact Me <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <div class="inner-page">
    <div class="page-rule"></div>
    <div class="content-grid"><div class="side-label">CORE SKILLS</div><div>
      <div class="tag-row" style="margin-top:0"><span class="tag">C#</span><span class="tag">ASP.NET</span><span class="tag">Microsoft SQL Server</span><span class="tag">SSIS</span><span class="tag">SQL Server Agent</span><span class="tag">Stored Procedures</span><span class="tag">Visual Studio</span><span class="tag">SSMS</span><span class="tag">SSDT</span><span class="tag">Debugging</span><span class="tag">Root-Cause Analysis</span><span class="tag">Production Validation</span><span class="tag">Technical Documentation</span></div>
    </div></div>
    <div class="page-rule"></div>
    <div class="content-grid"><div class="side-label" id="experience">EXPERIENCE</div><div class="timeline">
      <div class="timeline-item"><div class="timeline-date">JUNE 2023 - PRESENT</div><div><h3>Engineer 1, Software Development</h3><p class="employer">Comcast</p><p>Software development using C# and ASP.NET, contributing to applications and technical infrastructure.</p></div></div>
      <div class="timeline-item"><div class="timeline-date">MARCH 2019 - JUNE 2023</div><div><h3>Installation and Service Technician CT4</h3><p class="employer">Comcast</p><p>Advanced installations, particularly for business clients, including high-speed internet, television, and advanced internet and phone services. Provided tailored business solutions for more complex technical requirements than ordinary residential service work.</p></div></div>
      <div class="timeline-item"><div class="timeline-date">FEBRUARY 2015 - MARCH 2019</div><div><h3>Installation and Service Technician CT3</h3><p class="employer">Comcast</p><p>Troubleshooting and installation/service support for CDV/phone services, expanding the range of customer needs handled.</p></div></div>
      <div class="timeline-item"><div class="timeline-date">NOVEMBER 2014 - FEBRUARY 2015</div><div><h3>Installation and Service Technician CT2</h3><p class="employer">Comcast</p><p>Independent television and internet installations and service after demonstrating proficiency and passing the CT2 exam.</p></div></div>
      <div class="timeline-item"><div class="timeline-date">JULY 2014 - NOVEMBER 2014</div><div><h3>Installation and Service Technician CT1</h3><p class="employer">Comcast</p><p>Foundational residential internet and television installation, troubleshooting, and service work.</p></div></div>
    </div></div>
    <div class="page-rule"></div>
    <div class="content-grid"><div class="side-label">EDUCATION</div><div class="timeline">
      <div class="timeline-item"><div class="timeline-date">EXPECTED NOVEMBER 2028</div><div><h3>Doctor of Information Technology</h3><p>Capella University · In progress</p></div></div>
      <div class="timeline-item"><div class="timeline-date">SEPTEMBER 2025</div><div><h3>M.S. Information Systems Management</h3><p>University of Arizona Global Campus · GPA 4.0</p></div></div>
      <div class="timeline-item"><div class="timeline-date">FEBRUARY 2024</div><div><h3>B.S. Information Technology</h3><p>University of Arizona Global Campus · Magna Cum Laude · Dean's List 2020-2023</p></div></div>
    </div></div>
    <div class="page-rule"></div>
    <div class="content-grid"><div class="side-label">PROJECTS</div><div class="prose"><h2>Independent software projects</h2><p><strong>PresiCompare</strong> · Public-facing web application at <a href="https://presicompare.com/" target="_blank" rel="noreferrer">presicompare.com</a>.</p><p><strong>Huddle Up</strong> · Mobile application built with React Native and Expo, supported by an ASP.NET Core API.</p></div></div>
    <a class="action-link" href="mailto:lencrerotl0@gmail.com?subject=Resume%20Request">Contact me about my résumé <span>↗</span></a>
    <p style="font-size:.76rem;line-height:1.7;color:#777c83;margin-top:12px">This page is a web résumé summary. For a copy of my résumé, please contact me by email.</p>
  </div>
</BaseLayout>
<style>
  .inner-page{width:min(1120px,calc(100% - 72px));margin:0 auto;padding:72px 0 100px;color:#191b1f}
  .kicker{font-size:.66rem;letter-spacing:.16em;font-weight:700;color:#737880;margin:0 0 22px}
  .page-heading{font-size:clamp(3rem,7vw,6.5rem);line-height:.94;letter-spacing:-.075em;font-weight:650;margin:0 0 28px;max-width:950px}
  .page-heading span{color:#8a8f96}
  .page-lede{font-size:1.08rem;line-height:1.8;color:#5e636b;max-width:760px;margin:0}
  .page-rule{height:1px;background:#d9dce0;margin:44px 0}
  .content-grid{display:grid;grid-template-columns:220px 1fr;gap:50px}
  .side-label{font-size:.65rem;font-weight:700;letter-spacing:.13em;color:#7c8188}
  .prose h2{font-size:1.55rem;letter-spacing:-.04em;margin:0 0 15px}
  .prose p,.prose li{font-size:.93rem;line-height:1.9;color:#5d626a}
  .prose p{margin:0 0 17px}.prose ul{padding-left:21px;margin:0 0 25px}
  .info-card{border:1px solid #d9dce0;padding:24px;background:#fff}
  .info-card h3{margin:0 0 10px;font-size:1.05rem;letter-spacing:-.02em}.info-card p{margin:0;color:#646971;font-size:.85rem;line-height:1.8}
  .card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:30px}
  .tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.tag{border:1px solid #d5d8dc;padding:7px 10px;font-size:.67rem;font-weight:700;color:#5f646b}
  .black-panel{background:#111214;color:#fff;padding:28px}.black-panel p{color:#c2c5ca}
  .timeline{border-top:1px solid #d9dce0}.timeline-item{display:grid;grid-template-columns:160px 1fr;gap:28px;padding:24px 0;border-bottom:1px solid #d9dce0}.timeline-date{font-size:.7rem;letter-spacing:.08em;color:#777c83;font-weight:700}.timeline-item h3{margin:0 0 8px;font-size:1.2rem}.timeline-item p{margin:0;color:#626770;line-height:1.8;font-size:.87rem}
  .action-link{display:inline-flex;align-items:center;gap:12px;margin-top:22px;padding:13px 16px;background:#111214;color:#fff;text-decoration:none;font-size:.76rem;font-weight:700}.action-link:hover{background:#36393e}
  @media(max-width:700px){.inner-page{width:calc(100% - 36px);padding:48px 0 70px}.content-grid{grid-template-columns:1fr;gap:16px}.card-grid{grid-template-columns:1fr}.timeline-item{grid-template-columns:1fr;gap:9px}.page-lede{font-size:.98rem}}

  .timeline{border-top:1px solid #bfc6cd}
  .timeline-item{padding:25px 22px;background:rgba(255,255,255,.76);border-bottom:1px solid #d5dbe0}
  .timeline-item h3{font-size:1.18rem;letter-spacing:-.025em}
  .timeline-item p{max-width:760px}
  .timeline-item .employer{margin:0 0 8px;color:#68727b;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}

</style>
