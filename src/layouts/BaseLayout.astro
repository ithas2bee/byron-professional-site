---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Byron David Lencrerot III | Software Engineer & Doctoral Student',
  description = 'Professional profile of Byron David Lencrerot III, software engineer and Doctor of Information Technology student.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111315" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Byron David Lencrerot III home" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
          <span class="brand-mark">B<span>.</span></span>
          <span class="brand-copy"><strong>BYRON DAVID LENCREROT III</strong><small>SOFTWARE ENGINEERING / ACADEMIA</small></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/about/" class:list={{ active: Astro.url.pathname.startsWith('/about') }} aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>Profile</a>
          <a href="/projects/" class:list={{ active: Astro.url.pathname.startsWith('/projects') }} aria-current={Astro.url.pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="/academia/" class:list={{ active: Astro.url.pathname.startsWith('/academia') }} aria-current={Astro.url.pathname.startsWith('/academia') ? 'page' : undefined}>Academia</a>
          <a href="/teaching/" class:list={{ active: Astro.url.pathname.startsWith('/teaching') }} aria-current={Astro.url.pathname.startsWith('/teaching') ? 'page' : undefined}>Teaching</a>
          <a href="/resume/" class:list={{ active: Astro.url.pathname.startsWith('/resume') }} aria-current={Astro.url.pathname.startsWith('/resume') ? 'page' : undefined}>Résumé</a>
          <a class="nav-contact" href="/contact/" class:list={{ active: Astro.url.pathname.startsWith('/contact') }} aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}>Contact ↗</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="footer-brand" href="/">BYRON DAVID LENCREROT III</a>
        <span>SOFTWARE · SCHOLARSHIP · TEACHING</span>
        <a href="https://www.linkedin.com/in/byron-lencrerot-mism-340437147/" target="_blank" rel="noreferrer">LINKEDIN ↗</a>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root{font-family:Arial,Helvetica,sans-serif;color:#111820;background:#f7f8f9;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#111820;--dark:#10161d;--dark-soft:#1b242d;--silver:#aeb8c2;--line:#cbd2d9;--muted:#505b65;--paper:#f7f8f9;--page-max:1480px}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);line-height:1.55;overflow-x:hidden}
  a{color:inherit}
  img{max-width:100%}
  ::selection{background:#bac6d1;color:#10161d}
  .site-header{background:#10161d;color:#f7f8fa;border-bottom:1px solid #35414b;position:relative;z-index:5}
  .header-inner{width:min(var(--page-max),calc(100% - 72px));min-height:66px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;flex:0 0 auto}
  .brand-mark{width:27px;height:27px;display:grid;place-items:center;background:#f4f6f8;border:1px solid #aeb8c2;color:#10161d;font-size:.9rem;font-weight:750;letter-spacing:-.08em}
  .brand-mark span{color:#697581}
  .brand-copy{display:flex;flex-direction:column;gap:2px}
  .brand-copy strong{font-size:.58rem;letter-spacing:.065em;color:#f4f6f8}
  .brand-copy small{font-size:.42rem;letter-spacing:.13em;color:#aab5bf}
  .brand[aria-current="page"] .brand-copy{position:relative}
  .brand[aria-current="page"] .brand-copy::after{content:"";position:absolute;left:0;right:0;bottom:-7px;height:1px;background:#fff}
  .site-header nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(13px,2vw,28px);flex-wrap:wrap}
  .site-header nav a{display:inline-flex;align-items:center;min-height:32px;font-size:.67rem;font-weight:600;color:#e0e5e9;text-decoration:none;position:relative}
  .site-header nav a:hover{color:#fff}
  .site-header nav a.active:not(.nav-contact)::after{content:"";position:absolute;left:0;right:0;bottom:-7px;height:1px;background:#fff}
  .site-header nav .nav-contact{min-height:34px;border:1px solid #9ba7b1;color:#fff;padding:7px 12px}
  .site-header nav .nav-contact.active{background:#f4f6f8;color:#10161d}
  .site-header nav .nav-contact:hover{background:#fff;color:#10161d}
  .site-header a:focus-visible,a:focus-visible{outline:2px solid #6c8498;outline-offset:3px}
  main{min-height:70vh}
  .site-footer{background:#10161d;color:#c6cdd3;border-top:1px solid #35414b}
  .footer-inner{width:min(var(--page-max),calc(100% - 72px));min-height:68px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.55rem;letter-spacing:.08em;color:#aeb8c2}
  .footer-brand{font-weight:700;text-decoration:none;color:#f4f6f8}
  .footer-inner>a:not(.footer-brand){text-decoration:none}
  .footer-inner>a:hover{color:#fff}
  .page-width{width:min(var(--page-max),calc(100% - 72px));margin-inline:auto}
  .inner-page{width:min(1280px,calc(100% - 72px));margin:0 auto;padding:58px 0 88px}
  .kicker,.eyebrow{font-size:.61rem;line-height:1.5;letter-spacing:.13em;font-weight:700}
  .page-heading{font-size:clamp(2.5rem,5vw,4.7rem);line-height:.98;letter-spacing:-.055em;font-weight:650}
  .page-heading span{color:#8f9aa4}
  .page-lede{font-size:.93rem;line-height:1.65;color:#4f5a64}
  .page-rule{height:1px;background:var(--line);margin:34px 0}
  .action-link,.button{transition:background-color .15s ease,color .15s ease,border-color .15s ease}
  .m-hero{position:relative;overflow:hidden;color:#fff;background:#10161d center/cover no-repeat}
  .m-hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,18,.86) 0%,rgba(10,14,18,.55) 55%,rgba(10,14,18,.15) 100%)}
  .m-hero.light{color:var(--ink);background-color:#f4f5f6}
  .m-hero.light::before{background:linear-gradient(90deg,rgba(247,248,249,.96) 0%,rgba(247,248,249,.82) 50%,rgba(247,248,249,0) 100%)}
  .m-hero.plain::before{display:none}
  .m-in{position:relative;z-index:1;width:min(1380px,calc(100% - 80px));margin:0 auto;padding:60px 0;min-height:340px;display:flex;flex-direction:column;justify-content:center}
  .m-hero .kicker{margin:0 0 14px;color:#b9c3cc}.m-hero.light .kicker{color:#4b555e}
  .m-hero h1{font-size:clamp(2rem,3.6vw,3.2rem);line-height:1.1;letter-spacing:-.02em;font-weight:600;margin:0 0 20px;max-width:640px}
  .m-hero .lede{max-width:540px;font-size:.95rem;line-height:1.65;color:#d5dce2;margin:0}.m-hero.light .lede{color:#4f5a64}
  .m-actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:14px;padding:12px 16px;font-size:.78rem;font-weight:700;text-decoration:none;border:1px solid #10161d;background:#fff;color:#10161d}
  .btn.dark{background:#10161d;color:#fff}.m-hero:not(.light) .btn{border-color:#fff}
  .m-nodes{position:absolute;z-index:1;right:max(40px,calc((100% - 1380px)/2));top:50%;transform:translateY(-50%);list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px}
  .m-nodes li{position:relative;padding-left:28px;font-size:1rem;line-height:1.2;font-weight:600;max-width:140px}
  .m-nodes li::before{content:"";position:absolute;left:0;top:6px;width:11px;height:11px;border-radius:50%;background:#fff;box-shadow:0 0 0 4px rgba(255,255,255,.25)}
  .m-journey{width:min(1380px,calc(100% - 80px));margin:0 auto;padding:54px 0 70px}
  .m-journey h2{font-size:1.9rem;letter-spacing:-.02em;margin:0 0 30px;font-weight:600}
  .m-tl{list-style:none;margin:0;padding:0 0 0 110px;position:relative}
  .m-tl::before{content:"";position:absolute;left:326px;top:10px;bottom:10px;width:1px;background:var(--ink)}
  .m-tl li{display:grid;grid-template-columns:200px 36px 1fr;gap:0;padding:12px 0;align-items:start;font-size:.8rem}
  .m-tl time{color:#4f5a64;text-align:right;padding-right:0}
  .m-tl i{width:9px;height:9px;border-radius:50%;background:var(--ink);margin:5px auto 0;position:relative}
  .m-tl strong{display:block;font-size:.95rem;margin-bottom:3px}.m-tl span{color:#5b656e}
  .m-projects{width:min(1380px,calc(100% - 80px));margin:0 auto;padding:50px 0;display:grid;grid-template-columns:minmax(220px,.6fr) 1fr 1fr;gap:20px;align-items:stretch}
  .m-projects .intro h1{font-size:clamp(1.9rem,3vw,2.6rem);line-height:1.1;letter-spacing:-.02em;font-weight:600;margin:12px 0 18px}
  .m-card{position:relative;overflow:hidden;color:#fff;background:#10161d center/cover;padding:210px 22px 22px;display:flex;flex-direction:column;justify-content:flex-end;min-height:320px;border:1px solid #394650;border-radius:18px}
  @media(max-width:760px){.header-inner,.footer-inner{width:calc(100% - 32px)}.header-inner{min-height:0;padding:10px 0;gap:12px;align-items:flex-start}.site-header nav{width:100%;justify-content:flex-start;gap:8px 12px;flex-wrap:wrap}.site-header nav a{font-size:.58rem;min-height:24px}.site-header nav .nav-contact{padding:6px 9px}.brand-copy strong{font-size:.5rem}.brand-copy small{font-size:.38rem}.inner-page,.page-width{width:calc(100% - 32px)}.inner-page{padding-top:42px}.site-footer .footer-inner{padding:15px 0;align-items:flex-start;flex-direction:column}}
  @media(max-width:540px){.header-inner{flex-direction:column;align-items:flex-start}.brand{width:100%}.site-header nav{width:100%;justify-content:space-between;gap:8px}.site-header nav a{flex:1 1 calc(50% - 8px);justify-content:center;text-align:center;padding:6px 8px;border:1px solid rgba(255,255,255,.08)}.site-header nav .nav-contact{flex:1 1 calc(50% - 8px)}}
  @media(max-width:430px){.site-header nav{gap:8px}.site-header nav a{flex-basis:100%}}
  @media(max-width:760px){.site-header nav a{font-size:.57rem}}


  .m-card::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,14,18,.1) 0,rgba(10,14,18,.85) 190px,#10161d 260px)}
  .m-card>*{position:relative}.m-card h2{margin:0;font-size:1.35rem}.m-card p{margin:0;font-size:.8rem;color:#d1d8de;line-height:1.55}
  .m-card .tags{display:flex;flex-wrap:wrap;gap:6px}.m-card .tags span{background:#fff;color:#10161d;border-radius:12px;padding:3px 10px;font-size:.65rem;font-weight:600}
  .m-card .btn{align-self:flex-start;background:transparent;color:#fff;border-color:#8b98a3}
  .m-cards3{display:grid;gap:12px}.m-cards3 .c{display:grid;grid-template-columns:50px 1fr;gap:14px;border:1px solid #bfc6cd;background:#fff;padding:18px}
  .m-cards3 .c b{display:block;font-size:.9rem}.m-cards3 .c small{display:block;color:#5b656e;font-size:.72rem;line-height:1.5}
  .m-cards3 .c em{font-style:normal;font-size:1.6rem}
  .m-split{width:min(1380px,calc(100% - 80px));margin:0 auto;padding:54px 0;display:grid;grid-template-columns:1fr 1.1fr;gap:40px;align-items:center}
  .m-split h1{font-size:clamp(1.9rem,3vw,2.7rem);line-height:1.1;letter-spacing:-.02em;font-weight:600;margin:12px 0 18px}
  .m-contact{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .m-contact a{display:grid;grid-template-columns:48px 1fr;gap:14px;align-items:center;background:rgba(255,255,255,.92);color:var(--ink);border:1px solid #bfc6cd;padding:22px;text-decoration:none;font-size:.78rem}
  .m-contact b{display:block;font-size:.95rem}.m-contact em{font-style:normal;font-size:1.8rem;font-weight:700}
  @media(max-width:900px){.m-nodes{display:none}.m-tl{padding-left:0}.m-tl::before{left:155px}.m-tl li{grid-template-columns:130px 50px 1fr}.m-projects,.m-split,.m-contact{grid-template-columns:1fr}.m-in,.m-journey,.m-projects,.m-split{width:calc(100% - 32px)}}
  @media(max-width:760px){.header-inner,.footer-inner{width:calc(100% - 32px)}.header-inner{min-height:66px;gap:10px}.site-header nav{gap:9px 13px}.site-header nav a{font-size:.62rem}.brand-copy strong{font-size:.53rem}.brand-copy small{font-size:.38rem}.inner-page,.page-width{width:calc(100% - 32px)}.inner-page{padding-top:42px}.site-footer .footer-inner{padding:15px 0;align-items:flex-start;flex-direction:column}}
  @media(max-width:540px){.header-inner{align-items:flex-start;flex-direction:column;justify-content:center;padding:10px 0;gap:9px}.site-header nav{width:100%;justify-content:space-between;gap:8px}.site-header nav .nav-contact{padding:5px 8px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
</style>
